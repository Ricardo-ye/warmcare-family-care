<import src="../../templates.wxml"/>
<view class="screen {{large?'large':''}}">
 <template is="status" data="{{error,loading,busy,reminderError}}"/>
 <view wx:if="{{session}}">
  <view class="home-header"><view class="grow"><view class="eyebrow">暖心护 · {{session.me.role==='elder'?'长辈的日常':'一起照顾家人'}}</view><view class="title spaced">{{session.me.name}}，你好</view><view class="muted spaced">{{session.me.role==='elder'?'想说的话，留给家人。':'把关心放进每一天。'}}</view></view><image class="logo" src="/assets/brand-logo.png" aria-label="暖心护"/></view>
  <view wx:if="{{activeCount}}" class="card alert"><view class="eyebrow urgent-text">需要关注</view><view class="heading spaced">{{activeCount}} 条求助尚未结束</view><view wx:for="{{active}}" wx:key="id" class="spaced">{{item.elderName}} · {{item.confirmed}} 位家人已确认</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="danger full section" bindtap="go" data-page="sos">{{session.me.role==='elder'?'查看家人回应':'查看并回应求助'}}</button></view>
  <button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{session.me.role==='elder'}}" class="sos full section" bindtap="go" data-page="sos">SOS · 我需要家人帮忙</button>
  <view class="card message-summary"><view class="row between wrap"><view class="heading">家人消息</view><view class="pill {{session.unread?'unread-pill':''}}">{{session.unread?session.unread+' 条未读':'暂无未读'}}</view></view><view wx:if="{{latest}}" class="spaced"><view class="message-preview">{{latest.senderName}}：{{latest.text || '给你留了一段语音'}}</view></view><view wx:else class="muted spaced">留句话、发段语音，让家人知道你的近况。</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="go" data-page="messages">{{session.unread?'查看家人的留言':'看消息 · 给家人留言'}}</button></view>
  <view class="section-heading"><view class="heading">日常照护</view><view class="small muted">记录每一件小事</view></view>
  <view class="action-grid"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="action-tile" bindtap="go" data-page="records"><view class="action-symbol">记</view><view>生活记录</view><view class="small muted">整理日常情况</view></button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="action-tile" bindtap="go" data-page="todos"><view class="action-symbol">待</view><view>照护待办</view><view class="small muted">{{pending}} 件待完成</view></button></view>
  <view class="card"><view class="row between wrap"><view class="heading">{{session.me.role==='elder'?'我的家人':'我关注的长辈'}}</view><view class="small muted">家庭共 {{session.memberCount}} 人</view></view><view wx:if="{{session.me.role==='guardian'}}"><view wx:for="{{session.cared}}" wx:key="id" class="person-line"><view class="grow"><view>{{item.name}}</view><view class="small muted">{{item.note || '一起留意日常生活'}}</view></view></view><view wx:if="{{!session.caredCount}}" class="muted spaced">邀请长辈加入后，在家人页面设置关注。</view></view><view wx:else class="muted spaced">查看家人的联系电话，或邀请更多家人加入。</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="outline full section" bindtap="go" data-page="family">家人 · 关注与联系电话</button></view>
  <button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{session.me.role==='guardian'}}" class="danger full section" bindtap="go" data-page="sos">SOS · 查看求助与紧急联系</button>
  <view class="small muted section">打开小程序时自动检查新消息；紧急情况请同时电话联系。</view>
  <view class="notice small">{{session.notificationConfigured?'微信外部提醒需要接收人主动授权。':'微信订阅提醒尚未配置，退出小程序后暂不能收到微信推送。'}}</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{session.notificationConfigured}}" class="outline full" bindtap="subscribe">允许下一条重要提醒</button>
 </view>
</view>
