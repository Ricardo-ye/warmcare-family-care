<import src="../../templates.wxml"/><view class="screen {{large?'large':''}}"><view class="title">进入暖心护</view><template is="status" data="{{error,loading,busy,reminderError}}"/>
<view class="hero"><view class="heading">一家人的照护手记</view><view class="muted spaced">只向受邀家人开放，记录生活，彼此报个平安。</view></view>
<view wx:if="{{session}}" class="card"><view wx:if="{{session.me}}"><view class="heading">{{session.me.name}}，欢迎回来</view><view class="muted">已绑定：{{session.me.role==='elder'?'老人端':'家人端'}}</view></view><view wx:else><view wx:if="{{session.isOwner && !session.exists}}"><view class="heading">选择本人身份，创建家庭</view><view class="filters"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="{{role==='elder'?'primary':'soft'}}" bindtap="choose" data-role="elder">我是长辈</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="{{role==='guardian'?'primary':'soft'}}" bindtap="choose" data-role="guardian">我是家人</button></view></view><view wx:else><view class="heading">通过家人邀请加入</view><label class="label" for="token">一次性邀请码</label><input id="token" class="input" value="{{token}}" data-field="token" bindinput="input" maxlength="48" placeholder="粘贴家人发来的邀请码"/><view class="small muted">加入身份由邀请决定，不能自行切换成其他成员。</view></view><label class="label" for="name">家人怎么称呼你</label><input id="name" class="input" value="{{name}}" data-field="name" bindinput="input" maxlength="20" placeholder="例如：妈妈、小芳"/><label class="label" for="phone">家人联系电话（选填）</label><input id="phone" class="input" value="{{phone}}" data-field="phone" bindinput="input" maxlength="20" type="text"/><view class="small muted">填写后仅家庭成员可查看、主动拨打。</view></view><checkbox-group bindchange="agree"><label class="checkrow section"><checkbox value="yes" checked="{{consent}}" color="#a44424"/><text>我同意在受邀家庭内共享所填内容</text></label></checkbox-group><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="soft full section" bindtap="go" data-page="privacy">阅读用途与隐私说明</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="enter" disabled="{{busy || !consent}}" loading="{{busy}}">{{session.me?'进入我的家庭':session.isOwner&&!session.exists?'创建我的家庭':'接受邀请并加入'}}</button></view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="soft full section" bindtap="go" data-page="sos">需要紧急联系？查看电话入口</button><view class="brand-footer">个人开发 · 家庭内使用 · 不收费、不推广</view>
</view>
