<import src="../../templates.wxml"/><view class="screen {{large?'large':''}}"><view class="title">长辈资料</view><template is="status" data="{{error,loading,busy,reminderError}}"/>
<view class="card"><view class="heading">{{id?'编辑资料':'添加家中长辈'}}</view><label class="label" for="name">称呼（必填）</label><input id="name" class="input" value="{{name}}" data-field="name" bindinput="input" maxlength="30" placeholder="例如：奶奶"/><label class="label" for="relation">与我的关系（选填）</label><input id="relation" class="input" value="{{relation}}" data-field="relation" bindinput="input" maxlength="30"/><label class="label" for="note">生活习惯与偏好（选填）</label><textarea id="note" class="input textarea" value="{{note}}" data-field="note" bindinput="input" maxlength="300" placeholder="例如：喜欢清淡的饭菜、午后散步"/><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存资料</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{id}}" class="soft full section" bindtap="reset">取消编辑</button></view>
<view wx:for="{{elders}}" wx:key="id" class="card"><view class="heading">{{item.name}}</view><view class="muted">{{item.relation}}</view><view class="preserve spaced">{{item.note}}</view><view class="row wrap section"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="outline" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">编辑</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="danger" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">删除资料</button></view></view></view>
