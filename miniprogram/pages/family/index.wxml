<import src="../../templates.wxml"/>
<view class="screen {{large?'large':''}}">
 <view class="eyebrow">亲近的人，在这里</view><view class="title spaced">家庭成员</view><template is="status" data="{{error,loading,busy,reminderError}}"/>
 <view wx:if="{{session}}">
  <view class="muted spaced">已加入 {{session.memberCount}} / 20 位成员</view>
  <view class="filters message-filters"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="{{section==='members'?'selected':'soft'}}" data-section="members" bindtap="switchSection">成员</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="{{section==='invite'?'selected':'soft'}}" data-section="invite" bindtap="switchSection">添加成员</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="{{section==='profile'?'selected':'soft'}}" data-section="profile" bindtap="switchSection">本人资料</button></view>
  <view wx:if="{{section==='members'}}">
   <view class="small muted">{{session.me.isOwner?'你是家庭创建人，可以邀请或移除成员。':'你可以邀请家人加入；移除成员由家庭创建人操作。'}}</view>
   <view wx:for="{{session.members}}" wx:key="id" class="card"><view class="row between wrap"><view class="heading">{{item.name}}</view><view class="pill">{{item.role==='elder'?'长辈':'家人'}}{{item.isOwner?' · 创建人':''}}{{item.id===session.me.id?' · 我':''}}</view></view><view class="muted spaced">{{item.phone || '未填写联系电话'}}</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{item.phone && item.id!==session.me.id}}" class="outline full section" bindtap="call" data-phone="{{item.phone}}">打电话给 {{item.name}}</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{session.me.isOwner && item.id!==session.me.id}}" class="text-button section" bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">移除这位成员</button></view>
   <view wx:if="{{session.me.isOwner && session.departedContent}}" class="card"><view class="heading">离开成员的内容</view><view class="small muted spaced">移除成员时保留内容。需要腾出空间时，可统一清理其旧留言及共享记录；不会显示你无权查看的留言。</view><view class="spaced">旧留言 {{session.departedContent.messages}} 条 · 共享记录 {{session.departedContent.records}} 条</view><button hover-class="press-feedback" class="outline full section" bindtap="cleanupDeparted" disabled="{{busy}}">清理离开成员的内容</button></view><view wx:if="{{session.me.role==='guardian'}}" class="card"><view class="heading">关注的长辈</view><view class="small muted spaced">用于照护入口和旧版重要留言；SOS 仍提醒所有家人端成员。</view><view wx:for="{{session.notebook.elders}}" wx:key="id" class="row between section"><view class="grow">{{item.name}}</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="{{item.followed?'primary':'soft'}} compact" bindtap="follow" data-id="{{item.id}}" disabled="{{busy}}">{{item.followed?'已关注':'关注'}}</button></view></view>
  </view>
  <view wx:elif="{{section==='invite'}}">
   <view class="notice">成员需要用自己的微信接受邀请。邀请码24小时有效，每人使用一份。</view>
   <view class="card"><view class="heading">邀请谁加入</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="invite" data-role="guardian" disabled="{{busy || session.memberCount>=20}}">添加家人端成员</button><view wx:if="{{session.me.isOwner}}"><label class="label">老人端绑定资料</label><picker range="{{inviteElders}}" range-key="name" value="{{inviteElderIndex}}" bindchange="chooseInviteElder"><view class="input">{{inviteElders[inviteElderIndex].name}} ↓</view></picker><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="outline full section" bindtap="invite" data-role="elder" disabled="{{busy || session.memberCount>=20}}">添加老人端成员</button></view></view>
   <view wx:if="{{token}}" class="card"><view class="heading">{{inviteRole==='elder'?'老人端':'家人端'}}邀请已生成</view><view class="mono notice">{{token}}</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="copy">复制邀请码</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="outline full section" open-type="share">分享小程序邀请</button><view class="small muted spaced">若微信限制分享，请让对方扫描体验版二维码，再粘贴邀请码。</view></view>
   <view wx:if="{{pendingCount}}" class="section"><view class="heading">尚未使用的邀请 · {{pendingCount}}</view><view wx:for="{{pendingInvites}}" wx:key="id" class="card"><view>{{item.role==='elder'?'老人端':'家人端'}} · {{item.expiresLabel}} 到期</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="text-button section" bindtap="revokeOne" data-id="{{item.id}}" disabled="{{busy}}">撤销这份邀请</button></view></view>
   <button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{session.me.isOwner}}" class="text-button full section" bindtap="revoke" disabled="{{busy}}">撤销全部未使用邀请</button>
  </view>
  <view wx:else class="card"><label class="label" for="name">家人怎么称呼你</label><input class="input" id="name" value="{{name}}" data-field="name" bindinput="input" maxlength="20"/><label class="label" for="phone">联系电话（选填）</label><input class="input" id="phone" value="{{phone}}" data-field="phone" bindinput="input" maxlength="20"/><view class="small muted spaced">仅家庭成员可查看和主动拨打。</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="save" disabled="{{busy}}">保存本人资料</button></view>
 </view>
</view>
