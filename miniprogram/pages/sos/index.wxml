<import src="../../templates.wxml"/><view class="screen {{large?'large':''}}"><view class="title">联系家人求助</view><template is="status" data="{{error,loading,busy,reminderError}}"/>
<view class="muted spaced">先联系家人，确认有人回应。</view><view class="small muted spaced">此功能不会自动报警或拨号。紧急危险时请主动拨打紧急电话。</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="danger full section" bindtap="call" data-phone="120">拨打 120（需本人确认）</button>
<view wx:if="{{session}}"><view wx:if="{{alertCount}}" class="heading section">家人的求助与回应</view><view wx:for="{{alerts}}" wx:key="id" class="card {{item.status==='active'?'alert':''}}"><view class="heading">{{item.elderName}} · {{item.status==='active'?'等待家人处理':item.status==='cancelled'?'发起人已取消':'已结束'}}</view><view class="muted small">{{item.time}} · {{item.senderName}} 发起</view><view class="preserve spaced">{{item.note}}</view><view wx:if="{{!item.receiverCount}}" class="error">尚无其他家人端成员可以接收，请电话联系。</view><view wx:for="{{item.receivers}}" wx:for-item="person" wx:key="memberId" class="spaced">{{person.name}}：{{person.label}}</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{item.status==='active' && session.me.role==='guardian'}}" class="primary full section" bindtap="ack" data-id="{{item.id}}" disabled="{{busy || item.myReceipt.confirmedAt}}">{{item.myReceipt.confirmedAt?'我已确认收到':'我已收到，准备联系'}}</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{item.status==='active' && (item.mine || session.me.role==='guardian')}}" class="outline full section" bindtap="close" data-id="{{item.id}}" data-cancel="{{item.mine}}" disabled="{{busy}}">{{item.mine?'取消或结束本次求助':'确认本次求助已结束'}}</button></view><view class="card"><view class="heading">需要家人帮忙</view><picker wx:if="{{session.elderCount}}" range="{{session.notebook.elders}}" range-key="name" value="{{elderIndex}}" bindchange="choose"><view class="input section">{{session.notebook.elders[elderIndex].name}} ↓</view></picker><label class="label" for="note">补充说明（选填）</label><textarea class="input textarea" id="note" value="{{note}}" data-field="note" bindinput="input" maxlength="200" placeholder="例如：请马上给我打电话"/><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="sos full section" bindtap="raise" disabled="{{busy || !session.elderCount}}" loading="{{busy}}">向家人发送求助</button><view wx:if="{{!session.notificationConfigured}}" class="error">当前未配置微信推送。求助会保存在家庭内，请直接拨打下面的家人电话。</view></view>
<view class="heading section">直接电话联系</view><view wx:for="{{session.contacts}}" wx:key="id" class="card"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="outline full" bindtap="call" data-phone="{{item.phone}}">打给 {{item.name}}</button></view><view wx:if="{{!session.contactCount}}" class="notice">尚无家人填写联系电话。<button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="soft full section" bindtap="go" data-page="family">查看我的家人</button></view>
<button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{historyCount}}" class="outline full section" bindtap="toggleHistory">{{showHistory?'收起':'查看'}}已结束的求助（{{historyCount}}）</button><view wx:if="{{showHistory}}"><view wx:for="{{history}}" wx:key="id" class="card"><view class="heading">{{item.elderName}} · {{item.status==='cancelled'?'已取消':'已结束'}}</view><view class="small muted spaced">{{item.time}}</view><view class="preserve spaced">{{item.note}}</view><view class="small muted spaced">{{item.confirmed}} 位家人确认过收到</view></view></view></view>
</view>
