<import src="../../templates.wxml"/><view class="screen {{large?'large':''}}"><view class="title">个人待办</view><template is="status" data="{{error,loading,busy,reminderError}}"/><view wx:if="{{!loading && !error && !elderCount}}" class="empty">先添加一位长辈，再开始记录。<button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="go" data-page="elders">添加长辈</button></view><view wx:if="{{elderCount}}" class="card"><view class="heading">{{id?'编辑内容':'新建内容'}}</view><label class="label">关联长辈</label><picker range="{{elders}}" range-key="name" value="{{elderIndex}}" bindchange="chooseElder"><view class="input">{{elders[elderIndex].name}} ↓</view></picker><label class="label">日期</label><picker mode="date" value="{{date}}" bindchange="chooseDate"><view class="input">{{date}} ↓</view></picker><label class="label" for="title">要做的事（必填）</label><input id="title" class="input" value="{{title}}" data-field="title" bindinput="input" maxlength="100" placeholder="例如：周末整理换季衣物"/><view class="small muted spaced">日期用于本人查看安排，不会推送提醒。</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{id}}" class="soft full section" bindtap="reset">取消编辑</button></view><label class="label" for="query">查找已保存的内容</label><input id="query" class="input" value="{{query}}" bindinput="search" maxlength="100" placeholder="按长辈称呼或内容搜索"/><view class="filters"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="compact {{filter==='all'?'selected':'soft'}}" data-value="all" bindtap="filter">全部</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="compact {{filter==='pending'?'selected':'soft'}}" data-value="pending" bindtap="filter">未完成</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="compact {{filter==='done'?'selected':'soft'}}" data-value="done" bindtap="filter">已完成</button></view><view wx:for="{{items}}" wx:key="id" class="card"><view class="pill">{{item.elderName}} · {{item.done?'已完成':'未完成'}}</view><view class="heading spaced">{{item.title}}</view><view class="muted">{{item.date}} {{!item.done && item.date<today?'· 已过计划日期':''}}</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="primary full section" data-id="{{item.id}}" bindtap="toggle" disabled="{{busy}}">{{item.done?'恢复未完成':'标记完成'}}</button><view class="row wrap section"><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="outline" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">编辑</button><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" class="danger" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">删除</button></view></view><view wx:if="{{!loading && !error && !itemCount}}" class="notice">暂无符合条件的内容。</view><button hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" wx:if="{{hasMore}}" class="outline full section" bindtap="more">继续查看（共 {{total}} 条）</button></view>
