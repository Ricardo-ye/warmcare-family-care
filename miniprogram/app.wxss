page{background:#f8f5ef;color:#302d28;font-size:32rpx;line-height:1.65;font-family:system-ui,-apple-system,sans-serif}view,text,button,input,textarea{box-sizing:border-box}button{font:inherit;line-height:1.5;min-height:92rpx;border-radius:18rpx;padding:20rpx 28rpx;margin:0;white-space:normal}button::after{border:0}.screen{padding:36rpx 32rpx 72rpx}.large{font-size:38rpx}.title{font-size:48rpx;font-weight:700;line-height:1.4}.heading{font-size:38rpx;font-weight:700}.muted{color:#70685f}.small{font-size:26rpx}.large .small{font-size:32rpx}.eyebrow{font-size:24rpx;letter-spacing:3rpx;color:#944121;font-weight:600}.row{display:flex;align-items:center;gap:20rpx}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.stack>view+view,.stack>button+button{margin-top:20rpx}.section{margin-top:32rpx}.card{background:#fffdf9;border:2rpx solid #e5ddd2;border-radius:24rpx;padding:28rpx;margin-top:24rpx}.hero{background:#ede5d7;border-radius:28rpx;padding:32rpx;margin-top:28rpx}.logo{width:96rpx;height:96rpx;border-radius:24rpx;flex-shrink:0}.primary{background:#a44424;color:#fff}.outline{background:#fffdf9;border:2rpx solid #ac795f;color:#883819}.soft{background:#efe6da;color:#563e2e}.danger{color:#a32020;background:#fff1ed;border:2rpx solid #e6b5ab}.full{width:100%}.compact{padding:16rpx 22rpx;min-height:88rpx;font-size:28rpx}.label{display:block;font-weight:600;margin:24rpx 0 10rpx}.input{width:100%;min-height:96rpx;background:#fffdf9;border:2rpx solid #b8aa98;border-radius:16rpx;padding:22rpx;font:inherit;color:#302d28}.textarea{height:220rpx}.large .input{min-height:112rpx}.pill{display:inline-block;background:#efe7dc;border-radius:10rpx;padding:6rpx 14rpx;font-size:26rpx}.filters{display:flex;flex-wrap:wrap;gap:14rpx;margin:28rpx 0}.selected{background:#a44424;color:#fff}.notice,.error,.empty{padding:26rpx;border-radius:18rpx;margin:24rpx 0;word-break:break-word}.notice{background:#eee8dc;color:#5c5143}.error{background:#fff0ea;color:#8f2415}.empty{background:#fffdf9;border:2rpx dashed #c9bca9;text-align:center;padding:48rpx 24rpx}.empty .heading{margin-bottom:12rpx}.divider{height:2rpx;background:#e5ddd2;margin:26rpx 0}.preserve{white-space:pre-wrap;word-break:break-word}.checkrow{display:flex;gap:12rpx;align-items:center;min-height:96rpx}.history{padding:18rpx 0;border-bottom:2rpx solid #e5ddd2}.mono{font-size:24rpx;word-break:break-all}.large .row.responsive{display:block}.large .row.responsive>view+view{margin-top:16rpx}.spaced{margin-top:16rpx}.brand-footer{font-size:24rpx;color:#70685f;text-align:center;margin-top:48rpx}

.sos{background:#ad2626;color:white;font-size:40rpx;font-weight:700;min-height:124rpx}.alert{border:3rpx solid #ad2626}.message-text{white-space:pre-wrap;word-break:break-word}.recording{background:#fff0ea;border:2rpx solid #ad2626;padding:24rpx;border-radius:18rpx}.large .heading{font-size:44rpx}.large .compact{font-size:34rpx}

button.full{width:100%!important;max-width:none}button.grow{width:auto!important}button.sos{padding:26rpx 22rpx}
.filters button{flex:1;min-width:180rpx;width:auto!important;margin:0!important}.large .filters button{min-width:220rpx}
button{transition:transform .1s ease,opacity .1s ease}button.press-feedback{transform:translateY(2rpx) scale(.985);opacity:.78}button[disabled]{opacity:.58}.checkrow:active{background:#f0e4d6;border-radius:12rpx}@media(prefers-reduced-motion:reduce){button{transition:none}button.press-feedback{transform:none}}

.home-header{display:flex;align-items:center;gap:24rpx;padding:10rpx 0 18rpx}.home-header .logo{width:104rpx;height:104rpx}.home-header .title{word-break:break-word}.section-heading{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12rpx;margin:40rpx 0 20rpx}.action-grid{display:flex;gap:20rpx}.action-tile{flex:1;min-width:0;width:auto!important;text-align:left;background:#fffdf9;border:2rpx solid #e5ddd2;padding:26rpx;border-radius:24rpx;font-weight:600}.action-tile .small{font-weight:400;margin-top:8rpx}.action-symbol{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;background:#f0e4d6;color:#883819;border-radius:18rpx;font-size:30rpx;margin-bottom:20rpx}.message-summary{background:#f2e8da;border-color:#e4d5c1}.unread-pill{background:#a44424;color:#fff}.urgent-text{color:#a32020}.message-preview{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word}.person-line{display:flex;gap:20rpx;align-items:center;padding:22rpx 0;border-bottom:2rpx solid #e5ddd2}.message-filters{gap:12rpx}.message-filters button{flex:1;min-width:0;width:auto!important;padding:20rpx 8rpx}.message-card{border-left:6rpx solid #dfd4c4}.message-unread{border-left-color:#a44424}.message-mine{background:#f2ede4}.voice-button{background:#e9efdf;color:#35462d;border:2rpx solid #78886d;text-align:left}.receipt-list{border-top:2rpx solid #e1d6c5;margin-top:24rpx;padding-top:20rpx}.text-button{background:transparent;color:#795039;font-size:28rpx;text-decoration:underline;text-underline-offset:6rpx;padding:18rpx 8rpx;min-height:88rpx;width:auto!important}.large .text-button{font-size:34rpx}.large .action-grid{flex-direction:column}.large .message-filters{flex-wrap:wrap}.large .message-filters button{flex:auto;min-width:180rpx}.message-card .heading{word-break:break-word}.large .home-header{align-items:flex-start}
